{
  "name": "currency-converter-v2",
  "version": "2.0.0",
  "description": "In-page price converter that transforms prices into your preferred currency with live exchange rates.",
  "type": "module",
  "main": "src/background.js",
  "scripts": {
    "build": "node build.js",
    "build:gallery": "node build.js --gallery",
    "test": "node --test tests/**/*.test.js && node tests/parse.test.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/*.e2e.js",
    "lint:firefox": "web-ext lint --source-dir dist/firefox"
  },
  "keywords": [
    "chrome-extension",
    "firefox-addon",
    "currency-converter",
    "manifest-v3",
    "exchange-rates",
    "web-extension",
    "in-page-translation"
  ],
  "author": "Richmond Sogo <richmondsogo@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/richmondsogo/currency-converter-v2.git"
  },
  "bugs": {
    "url": "https://github.com/richmondsogo/currency-converter-v2/issues"
  },
  "homepage": "https://github.com/richmondsogo/currency-converter-v2#readme",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.64.1",
    "selenium-webdriver": "^4.51.0",
    "web-ext": "^10.8.0"
  },
  "dependencies": {
    "@fontsource/familjen-grotesk": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.61.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19"
  }
}
